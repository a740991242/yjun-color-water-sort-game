{
  "name": "yjun-color-water-sort-game",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.1",
  "description": "魔彩瓶 React + Canvas color water sort game",
  "license": "MIT",
  "keywords": [
    "mocaiping",
    "color-water-sort",
    "canvas-game",
    "react19",
    "react",
    "h5",
    "mobile",
    "antd-mobile",
    "vite"
  ],
  "engines": {
    "node": ">=20.19.0 || >=22.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite -m dev",
    "dev:test": "vite -m test",
    "dev:pro": "vite -m pro",
    "build": "pnpm vite build -m pro",
    "build:dev": "pnpm vite build -m dev",
    "build:test": "pnpm vite build -m test",
    "build:pro": "pnpm vite build -m pro",
    "preview": "pnpm vite preview -m pro",
    "preview:dev": "pnpm vite preview -m dev",
    "preview:test": "pnpm vite preview -m test",
    "preview:pro": "pnpm vite preview -m pro",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:inspector": "npx @eslint/config-inspector",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "npx simple-git-hooks",
    "clean": "rm -rf node_modules dist dist-*",
    "deps:check": "pnpm outdated -r"
  },
  "dependencies": {
    "ahooks": "^3.9.7",
    "antd-mobile": "5.42.3",
    "axios": "^1.16.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.20",
    "immer": "^11.1.8",
    "lodash-es": "^4.18.1",
    "motion": "^12.40.0",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "react-router": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.8.4",
    "@react-dev-inspector/vite-plugin": "^2.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "amfe-flexible": "^2.2.1",
    "eslint": "^10.4.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lint-staged": "^17.0.5",
    "postcss-preset-env": "^11.3.0",
    "postcss-pxtorem": "^6.1.0",
    "react-dev-inspector": "^2.0.1",
    "sass": "^1.100.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.13.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
